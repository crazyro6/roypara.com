---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Radar from "@/components/Radar.astro";
import { profile } from "@/data/profile";
import { scene } from "@/lib/flights";
import { useT } from "@/i18n/ui";

// Página única y bilingüe: Cloudflare la sirve para cualquier ruta inexistente.
const es = useT("es").t;
const en = useT("en").t;
const empty = scene(undefined, profile.radarCenter);
---

<Layout lang="es" title={`404 · ${profile.name}`} noindex>
  <Header lang="es" over />
  <main id="main" class="notfound on-scope">
    <div class="wrap inner">
      <div class="copy">
        <p class="code data rise">404</p>
        <h1 class="rise" style="--i:1">{es("notFoundTitle")}</h1>
        <p class="text rise" style="--i:2">
          {es("notFoundText")} <span lang="en">{en("notFoundText")}</span>
        </p>
        <p class="actions rise" style="--i:3">
          <a class="btn btn--fill" href="/">{es("backHome")}</a>
          <a class="btn btn--line" href="/en/" lang="en">{en("backHome")}</a>
        </p>
      </div>
      <Radar scene={empty} lang="es" class="scope" />
    </div>
  </main>
</Layout>

<style>
  .notfound {
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-block: 6rem 3rem;
    background: var(--scope);
  }

  .inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .code {
    color: var(--accent);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .text {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  span[lang="en"] {
    display: block;
    color: var(--ink-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .notfound :global(.scope) {
    --cy: 0.6;
    --rw: 0.48;
    --rh: 1;
    justify-self: center;
    width: min(100%, 34rem);
    aspect-ratio: 4 / 3;
  }
</style>
