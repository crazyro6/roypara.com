---
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css";
import "@fontsource-variable/atkinson-hyperlegible-mono/wght.css";
import sansUrl from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import "@/styles/global.css";

import { profile } from "@/data/profile";
import { htmlLang, langs, pathFor, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  noindex?: boolean;
  /** Redirige a /en/ si el navegador no tiene el español entre sus idiomas. */
  autoLang?: boolean;
}

const { lang, title, noindex = false, autoLang = false } = Astro.props;
const { t, tr } = useT(lang);

const pageTitle = title ?? `${profile.name} · ${tr(profile.role)}`;
const description = t("metaDescription");
const site = Astro.site!;
const canonical = new URL(pathFor(lang), site).href;
const ogImage = new URL("/og.png", site).href;

// Primera visita a la portada en español desde un navegador que no tiene el
// español entre sus idiomas: se pasa a la versión inglesa. Si la persona
// elige idioma con el selector (se guarda en localStorage), se respeta siempre.
const autoLangScript = `(() => {
  try {
    if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;
    const saved = localStorage.getItem("lang");
    if (saved === "es") return;
    const prefs = navigator.languages?.length ? navigator.languages : [navigator.language];
    if (saved === "en" || !prefs.some((l) => /^es(-|$)/i.test(l))) {
      location.replace("/en/" + location.search + location.hash);
    }
  } catch {}
})();`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: site.href,
  image: ogImage,
  email: `mailto:${profile.email}`,
  jobTitle: tr(profile.role),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Vecindario",
    addressRegion: "Las Palmas",
    addressCountry: "ES",
  },
  alumniOf: ["IES Lomo de la Herradura", "Colegio Heidelberg"],
  knowsLanguage: ["es", "en", "de"],
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={canonical} />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={htmlLang[l]} href={new URL(pathFor(l), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e11" media="(prefers-color-scheme: dark)" />

    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />

    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {autoLang && <script is:inline set:html={autoLangScript} />}
  </head>
  <body>
    <a class="skip" href="#main">{t("skip")}</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    z-index: calc(var(--z-header) + 1);
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    transition: top 0.2s var(--ease-out);
  }

  .skip:focus {
    top: 1rem;
  }
</style>
