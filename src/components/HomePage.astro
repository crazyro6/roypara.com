---
import Layout from "@/layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Timeline from "./Timeline.astro";
import Stack from "./Stack.astro";
import GithubCalendar from "./GithubCalendar.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { education, experience, profile } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useT(lang);
---

<Layout lang={lang}>
  <Header lang={lang} />
  <main id="main" class="wrap">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Timeline lang={lang} id="experiencia" title={t("experienceTitle")} items={experience} />
    <Timeline lang={lang} id="formacion" title={t("educationTitle")} items={education} />
    <Stack lang={lang} />
    {profile.showGithubCalendar && <GithubCalendar lang={lang} />}
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
