---
import Layout from "@/layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Now from "./Now.astro";
import Timeline from "./Timeline.astro";
import Stack from "./Stack.astro";
import GithubCalendar from "./GithubCalendar.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { certifications, education, experience, profile } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useT(lang);
---

<Layout lang={lang} autoLang={lang === "es"}>
  <Header lang={lang} over sections />
  <main id="main">
    <Hero lang={lang} />
    <div class="wrap">
      <Projects lang={lang} />
      <Now lang={lang} />
      <Timeline
        lang={lang}
        id="trayectoria"
        title={t("pathTitle")}
        groups={[
          { label: t("experienceTitle"), items: experience },
          { label: t("educationTitle"), items: education },
          { label: t("certificationsTitle"), items: certifications },
        ]}
      />
      <Stack lang={lang} />
      {profile.showGithubCalendar && <GithubCalendar lang={lang} />}
    </div>
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
