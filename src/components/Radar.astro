---
// Lienzo del radar 3D (la lógica está en src/lib/radar.ts). Quien lo usa
// decide el encuadre con --cx, --cy (centro) y --rw, --rh (radio máximo),
// como fracciones del ancho y el alto del lienzo.
import { scene } from "@/lib/sky";
import { profile } from "@/data/profile";
import { htmlLang, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  class?: string;
  label?: string; // sin texto alternativo, el radar es decorativo
  live?: boolean; // false: solo el mapa, sin preguntar a la antena
}

const { lang, class: className, label, live = true } = Astro.props;
const { t } = useT(lang);

// Los textos de estado los pone el script; {n} es el número de aviones.
const labels = {
  connecting: t("radarConnecting"),
  live: t("radarLive", { n: "{n}" }),
  quiet: t("radarQuiet"),
  offline: t("radarOffline"),
};
const data = { ...scene(), live, labels };
---

<div class:list={["radar", className]} data-radar data-tz={profile.timeZone} data-locale={htmlLang[lang]}>
  <canvas {...label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" }}></canvas>
  <script is:inline type="application/json" set:html={JSON.stringify(data)} />
</div>

<script>
  import { mount } from "@/lib/radar";
  document.querySelectorAll<HTMLElement>("[data-radar]").forEach(mount);
</script>

<style>
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
