---
// Radar minimalista: anillos finos, estelas que se desvanecen hacia atrás
// y un barrido que gira despacio. Cada avión (el único color, ámbar) se
// enciende cuando el barrido pasa por su rumbo, y su indicativo aparece
// solo en ese momento.
import type { Plot } from "@/lib/flights";

interface Props {
  radar: Plot;
  title?: string; // sin título, el radar es decorativo
}

const { radar, title } = Astro.props;
const R = radar.r;
const PERIOD = 8; // segundos por vuelta
const fs = R * 0.04;
const named = new Set(radar.tracks.filter((t) => t.flight).slice(0, 6));
const delay = (bearing: number) => `${((bearing / 360) * PERIOD - PERIOD).toFixed(2)}s`;
---

<div class="radar" style={`--period:${PERIOD}s`}>
  <svg
    viewBox={`${-R * 1.06} ${-R * 1.06} ${R * 2.12} ${R * 2.12}`}
    {...title ? { role: "img", "aria-label": title } : { "aria-hidden": "true" }}
  >
    <defs>
      <clipPath id="radar-clip">
        <circle r={R}></circle>
      </clipPath>
      {
        radar.tracks.map((t, i) => (
          <linearGradient
            id={`trail-${i}`}
            gradientUnits="userSpaceOnUse"
            x1={t.start[0]}
            y1={t.start[1]}
            x2={t.end[0]}
            y2={t.end[1]}
          >
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0.55" />
          </linearGradient>
        ))
      }
    </defs>

    <g class="rings">
      {radar.rings.map((r, i) => <circle r={r} class={i === radar.rings.length - 1 ? "outer" : ""} />)}
      <line class="north" x1="0" x2="0" y1={-R} y2={-R * 1.035}></line>
    </g>
    <text class="n" x="0" y={-R * 1.052} font-size={fs * 0.9} text-anchor="middle">N</text>

    <g clip-path="url(#radar-clip)">
      {
        radar.tracks.map((t, i) => (
          <path class="trail" d={t.d} stroke={`url(#trail-${i})`} pathLength="1" style={`--i:${i}`} />
        ))
      }
      {
        radar.tracks.map((t) => (
          <g class="plane" style={`--d:${delay(t.bearing)}`}>
            <circle cx={t.end[0]} cy={t.end[1]} r={fs * 0.24} />
            {named.has(t) && (
              <text x={t.end[0] + fs * 0.55} y={t.end[1] + fs * 0.32} font-size={fs * 0.9}>
                {t.flight}
              </text>
            )}
          </g>
        ))
      }
    </g>

    <circle class="home" r={fs * 0.18}></circle>
  </svg>
  <div class="sweep" aria-hidden="true"></div>
</div>

<style>
  .radar {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    color: var(--scope-ink);
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .rings {
    fill: none;
    stroke: currentColor;
    stroke-opacity: 0.09;
    stroke-width: 1;
  }

  .rings * {
    vector-effect: non-scaling-stroke;
  }

  .rings .outer,
  .rings .north {
    stroke-opacity: 0.22;
  }

  .n {
    fill: currentColor;
    opacity: 0.45;
    font-family: var(--font-data);
  }

  .trail {
    fill: none;
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    animation: draw 3s var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms + 300ms);
  }

  .plane circle {
    fill: var(--track);
    opacity: 0.45;
    animation: blip var(--period) linear infinite;
    animation-delay: var(--d);
  }

  .plane text {
    fill: currentColor;
    font-family: var(--font-data);
    opacity: 0;
    animation: tag var(--period) linear infinite;
    animation-delay: var(--d);
  }

  .home {
    fill: currentColor;
    opacity: 0.8;
  }

  /* El barrido: una línea fina con una estela muy suave detrás. */
  .sweep {
    position: absolute;
    inset: calc(100% * 0.06 / 2.12);
    border-radius: 50%;
    background: conic-gradient(
      transparent 0 86%,
      color-mix(in oklch, var(--scope-ink) 7%, transparent) 99.7%,
      color-mix(in oklch, var(--scope-ink) 55%, transparent) 99.75% 100%
    );
    mix-blend-mode: screen;
    pointer-events: none;
    animation: sweep var(--period) linear infinite;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes sweep {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes blip {
    0% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.45;
    }
  }

  @keyframes tag {
    0% {
      opacity: 0;
    }
    3%,
    22% {
      opacity: 0.85;
    }
    35%,
    100% {
      opacity: 0;
    }
  }

  /* Movimiento reducido: radar quieto, aviones e indicativos visibles. */
  @media (prefers-reduced-motion: reduce) {
    .sweep {
      display: none;
    }

    .plane circle {
      opacity: 0.9;
    }

    .plane text {
      opacity: 0.75;
    }
  }
</style>
