---
import { languages, stack } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tr } = useT(lang);
---

<section class="section" id="stack" aria-labelledby="stack-title">
  <h2 id="stack-title" class="section-title">{t("stackTitle")}</h2>

  <dl class="groups">
    {
      stack.map((g) => (
        <div class="group">
          <dt class="label">{tr(g.group)}</dt>
          <dd>{g.items.join(", ")}</dd>
        </div>
      ))
    }
    <div class="group">
      <dt class="label">{t("languagesTitle")}</dt>
      <dd>
        <ul class="langs" role="list">
          {
            languages.map((l) => (
              <li>
                {tr(l.name)} <span class="data level">{tr(l.level)}</span>
              </li>
            ))
          }
        </ul>
      </dd>
    </div>
  </dl>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.75rem 2.5rem;
  }

  .group {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .label {
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  dd {
    margin: 0;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0;
    list-style: none;
  }

  .level {
    margin-left: 0.25rem;
    color: var(--ink-3);
  }
</style>
