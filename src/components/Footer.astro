---
import { profile } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useT(lang);
const year = new Date().getFullYear();
---

<footer class="wrap footer">
  <p>© {year} {profile.name}</p>
  <ul class="links" role="list">
    <li>
      <a class="link" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
    </li>
    <li>
      <a class="link" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </li>
    {
      profile.sourceRepo ? (
        <li>
          <a class="link" href={profile.sourceRepo} target="_blank" rel="noopener">
            {t("sourceCode")}
          </a>
        </li>
      ) : (
        <li>{t("builtWith")}</li>
      )
    }
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-block: 2rem 2.5rem;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .footer::before {
    content: "";
    flex-basis: 100%;
    height: 1px;
    margin-bottom: 1.25rem;
    background: var(--line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }
</style>
