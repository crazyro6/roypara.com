---
import { profile } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useT(lang);
const year = new Date().getFullYear();
---

<footer class="footer on-scope">
  <div class="wrap">
    <div class="row">
      <p>© {year} {profile.name}</p>
      <ul class="links" role="list">
        <li>
          <a
            class="link"
            href={profile.links.github}
            target="_blank"
            rel="noopener">GitHub</a
          >
        </li>
        <li>
          <a
            class="link"
            href={profile.links.linkedin}
            target="_blank"
            rel="noopener">LinkedIn</a
          >
        </li>
        {
          profile.sourceRepo ? (
            <li>
              <a
                class="link"
                href={profile.sourceRepo}
                target="_blank"
                rel="noopener"
              >
                {t("sourceCode")}
              </a>
            </li>
          ) : (
            <li>{t("builtWith")}</li>
          )
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Continúa la banda oscura del contacto. */
  .footer {
    background: var(--scope);
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    list-style: none;
  }
</style>
