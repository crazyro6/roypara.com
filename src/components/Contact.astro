---
import { Image } from "astro:assets";
import photo from "@/assets/roy.jpg";
import { profile } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useT(lang);

const ways = [
  {
    text: profile.email,
    href: `mailto:${profile.email}`,
    copyLabel: t("copyEmail"),
  },
];
if (profile.phone) {
  ways.push({
    text: profile.phone,
    href: `tel:${profile.phone.replace(/\s/g, "")}`,
    copyLabel: t("copyPhone"),
  });
}
---

<section class="closing on-scope" id="contacto" aria-labelledby="contact-title">
  <svg class="rings" viewBox="-100 -100 200 200" aria-hidden="true">
    {[25, 50, 75, 100].map((r) => <circle r={r} />)}
    <line x1="-100" x2="100" y1="0" y2="0"></line>
    <line y1="-100" y2="100" x1="0" x2="0"></line>
  </svg>
  <div class="grain layer" aria-hidden="true"></div>
  <div class="horizon horizon--top" aria-hidden="true"></div>

  <div class="wrap inner">
    <figure class="portrait">
      <Image
        src={photo}
        alt={t("photoAlt")}
        widths={[320, 480, 640]}
        sizes="(min-width: 60rem) 22rem, 70vw"
        loading="lazy"
      />
    </figure>

    <div class="note">
      <h2 id="contact-title" class="title">{t("contactTitle")}</h2>
      <p class="text">{t("contactText")}</p>
    </div>

    <ul class="ways" role="list">
      {
        ways.map((w) => (
          <li class="way">
            <a class="address" href={w.href}>
              {w.text}
            </a>
            <button
              class="copy"
              type="button"
              data-copy={w.text}
              data-done={t("copied")}
              aria-label={w.copyLabel}
            >
              <span data-copy-label>{t("copy")}</span>
            </button>
            <span class="sr-only" role="status" data-copy-status />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) => {
      const label = button.querySelector<HTMLElement>("[data-copy-label]")!;
      const status =
        button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
      const original = label.textContent;
      let timer: number | undefined;

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
        } catch {
          return;
        }
        label.textContent = button.dataset.done ?? "";
        button.dataset.state = "done";
        if (status) status.textContent = button.dataset.done ?? "";
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
          delete button.dataset.state;
          if (status) status.textContent = "";
        }, 2000);
      });
    });
</script>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: clamp(5rem, 4rem + 5vw, 9rem);
    padding-block: clamp(8rem, 6rem + 8vw, 13rem)
      clamp(3rem, 2rem + 3vw, 5rem);
    background: var(--scope);
  }

  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Eco del radar de arriba, quieto. */
  .rings {
    position: absolute;
    z-index: -1;
    right: -12rem;
    top: 50%;
    width: 44rem;
    translate: 0 -50%;
    fill: none;
    stroke: var(--scope-line);
    stroke-width: 1;
    overflow: visible;
  }

  .rings * {
    vector-effect: non-scaling-stroke;
  }

  .inner {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: minmax(0, 1fr) 22rem;
      grid-template-areas:
        "note portrait"
        "ways portrait";
      align-content: center;
      column-gap: 5rem;
    }

    .note {
      grid-area: note;
      align-self: end;
    }

    .ways {
      grid-area: ways;
      align-self: start;
    }

    .portrait {
      grid-area: portrait;
    }
  }

  .note {
    display: grid;
    gap: 1rem;
    max-width: 38rem;
  }

  /* La foto: la única imagen clara de la página, sobre el cielo oscuro. */
  .portrait {
    justify-self: start;
    width: min(100%, 17rem);
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.25rem;
    background: var(--surface);
    box-shadow: 0 0 0 1px oklch(1 0 0 / 0.1), 0 30px 60px -30px oklch(0 0 0 / 0.8);
  }

  @media (min-width: 60rem) {
    .portrait {
      justify-self: end;
      width: 100%;
    }
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .portrait:hover :global(img) {
    transform: scale(1.03);
  }

  .title {
    margin-top: 0.5rem;
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .text {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .ways {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .way {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .address {
    color: var(--ink);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 50%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
    transition:
      color 0.25s var(--ease-out),
      text-decoration-color 0.25s var(--ease-out);
  }

  .address:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .copy {
    min-width: 5.5rem;
    min-height: 2.25rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-size: var(--step--1);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .copy:hover {
    color: var(--ink);
    border-color: var(--ink-3);
    background: var(--surface);
  }

  .copy[data-state="done"] {
    color: var(--ink);
    border-color: var(--accent);
  }

  @media (max-width: 40rem) {
    .rings {
      right: -16rem;
      width: 30rem;
      opacity: 0.6;
    }
  }
</style>
