---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { TimelineItem } from "@/data/profile";
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  id: string;
  title: string;
  // Experiencia, formación, certificaciones… en una sola sección.
  groups: { label: string; items: TimelineItem[] }[];
}

const { lang, id, title } = Astro.props;
const groups = Astro.props.groups.filter((g) => g.items.length > 0);
const { t, tr } = useT(lang);
const inPublic = (file: string) =>
  existsSync(join(process.cwd(), "public", file));
---

{
  groups.length > 0 && (
    <section class="section" id={id} aria-labelledby={`${id}-title`}>
      <h2 id={`${id}-title`} class="section-title">
        {title}
      </h2>

      <div class="groups" data-route>
        <div class="route" aria-hidden="true">
          <span class="flown" />
          <svg class="plane" viewBox="-10 -10 20 20">
            <path
              transform="rotate(180)"
              d="M0-9c1 0 1.4 1 1.4 2.5V-2L9 2.5v1.7L1.4 2v4L4 7.8V9L0 8l-4 1V7.8L-1.4 6V2L-9 4.2V2.5L-1.4-2v-4.5C-1.4-8-1-9 0-9Z"
            />
          </svg>
        </div>
        {groups.map((g) => (
          <div class="group">
            <h3 class="label">{g.label}</h3>
            <ol class="timeline" role="list">
              {g.items.map((e) => (
                <li class="item">
                  <p class="period data">{tr(e.period)}</p>
                  <div>
                    <h4 class="title">{tr(e.title)}</h4>
                    <p class="place">
                      {e.placeUrl ? (
                        <a
                          class="link"
                          href={e.placeUrl}
                          target="_blank"
                          rel="noopener"
                        >
                          {e.place}
                        </a>
                      ) : (
                        e.place
                      )}
                    </p>
                    <p class="note">{tr(e.note)}</p>
                    {e.file && inPublic(e.file) && (
                      <p class="file">
                        <a
                          class="link"
                          href={e.file}
                          target="_blank"
                          rel="noopener"
                        >
                          {t("viewCertificate")}
                          <span class="sr-only">: {tr(e.title)}</span>
                          <span class="arrow" aria-hidden="true">
                            ↗
                          </span>
                        </a>
                      </p>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  )
}

<script>
  // La ruta se dibuja según bajas: la línea llega hasta el 60 % de la pantalla,
  // el avión va en su punta y cada etapa se enciende cuando la línea la alcanza.
  // Sin JavaScript o con movimiento reducido se ve la ruta entera.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-route]").forEach((el) => {
      const items = [...el.querySelectorAll<HTMLElement>(".item")];
      let queued = false;
      const update = () => {
        queued = false;
        const at = innerHeight * 0.6;
        const r = el.getBoundingClientRect();
        el.style.setProperty("--p", Math.min(1, Math.max(0, (at - r.top) / r.height)).toFixed(4));
        for (const it of items) it.classList.toggle("passed", it.getBoundingClientRect().top + 10 < at);
      };
      const queue = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      };
      el.dataset.route = "on";
      update();
      addEventListener("scroll", queue, { passive: true });
      addEventListener("resize", queue);
    });
  }
</script>

<style>
  .groups {
    --p: 1;
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-left: 2.5rem;
  }

  /* La ruta: discontinua la que falta por volar, sólida la ya volada. */
  .route {
    position: absolute;
    left: 0.75rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    translate: -50% 0;
    background: repeating-linear-gradient(to bottom, var(--line) 0 5px, transparent 5px 11px);
  }

  .flown {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--p) * 100%);
    border-radius: 1px;
    background: linear-gradient(to bottom, color-mix(in oklch, var(--accent) 15%, transparent), var(--accent));
  }

  .plane {
    position: absolute;
    left: 50%;
    top: calc(var(--p) * 100%);
    width: 1.375rem;
    height: 1.375rem;
    max-width: none; /* el svg { max-width: 100% } global lo encogería al ancho de la línea */
    translate: -50% -50%;
    fill: var(--plane);
    filter: drop-shadow(0 0 6px color-mix(in oklch, var(--plane) 55%, transparent));
  }

  .label {
    margin-bottom: 1rem;
    color: var(--ink-3);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .timeline {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
  }

  /* Cada etapa es un punto de paso sobre la ruta. */
  .item::before {
    content: "";
    position: absolute;
    left: calc(-1.75rem - 0.3125rem);
    top: 0.4em;
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    transition:
      border-color 0.4s var(--ease-out),
      background-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .groups:not([data-route="on"]) .item::before,
  .item.passed::before {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent) 18%, transparent);
  }

  .period {
    padding-top: 0.1em;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .title {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .place {
    color: var(--ink-2);
  }

  .note {
    margin-top: 0.35rem;
    max-width: 60ch;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .file {
    margin-top: 0.5rem;
    font-size: var(--step--1);
  }

  @media (max-width: 36rem) {
    .item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
