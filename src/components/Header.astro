---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "@/data/profile";
import { pathFor, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
  /** Sobre el cielo del radar: posición absoluta y colores claros. */
  over?: boolean;
  /** Enlaces a secciones de la portada. */
  sections?: boolean;
}

const { lang, over = false, sections = false } = Astro.props;
const { t } = useT(lang);
const other: Lang = lang === "es" ? "en" : "es";
---

<header class:list={["wrap header", { "header--over on-scope": over }]}>
  <a class="brand" href={pathFor(lang)} aria-label={profile.name}>
    <Logo class="mark" />
    <span>{profile.shortName}</span>
  </a>

  <nav class="actions" aria-label={t("navLabel")}>
    {
      sections && (
        <ul class="sections" role="list">
          <li><a href="#proyectos">{t("projectsTitle")}</a></li>
          <li><a href="#trayectoria">{t("pathTitle")}</a></li>
          <li><a href="#contacto">{t("contactNav")}</a></li>
        </ul>
      )
    }
    <a class="lang data" href={pathFor(other)} hreflang={other} lang={other} data-lang={other}>
      <span class="sr-only">{t("switchLang")}: </span>{other.toUpperCase()}
    </a>
    <ThemeToggle lang={lang} />
  </nav>
</header>

<script>
  // Recordar el idioma elegido a mano para no redirigir nunca en contra.
  document.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((a) =>
    a.addEventListener("click", () => {
      try {
        localStorage.setItem("lang", a.dataset.lang!);
      } catch {}
    }),
  );
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.25rem, 3vw, 1.75rem);
  }

  .header--over {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--z-header);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    white-space: nowrap;
    font-weight: 650;
    text-decoration: none;
  }

  .brand :global(.mark) {
    flex: none;
    width: 1.7rem; /* proporción del monograma: 1990 × 2232 */
    height: 1.9rem;
    transition: transform 0.4s var(--ease-out);
  }

  .brand:hover :global(.mark) {
    transform: translateX(-2px) skewX(-6deg);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sections {
    display: none;
    gap: 1.75rem;
    margin-right: 1.25rem;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .sections a {
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .sections a:hover {
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .sections {
      display: flex;
    }
  }

  .lang {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .lang:hover {
    color: var(--ink);
    border-color: var(--ink-3);
    background: var(--surface);
  }
</style>
