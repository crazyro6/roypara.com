---
import { useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { t } = useT(Astro.props.lang);
---

<button
  class="toggle"
  type="button"
  data-theme-toggle
  data-label-light={t("themeLight")}
  data-label-dark={t("themeDark")}
  aria-label={t("themeDark")}
>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"
      ></path>
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;

  const sync = () => {
    if (!button) return;
    const isDark = root.dataset.theme === "dark";
    button.setAttribute(
      "aria-label",
      (isDark ? button.dataset.labelLight : button.dataset.labelDark) ?? "",
    );
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
      .forEach((m) => (m.content = isDark ? "#111519" : "#ffffff"));
  };

  const apply = (theme: "light" | "dark") => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    sync();
  };

  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduce) return apply(next);
    document.startViewTransition(() => apply(next));
  });

  sync();
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .toggle:hover {
    color: var(--ink);
    border-color: var(--ink-3);
    background: var(--surface);
  }

  .toggle svg {
    grid-area: 1 / 1;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  /* Muestra el icono del tema al que vas a cambiar. */
  :global([data-theme="light"]) .sun,
  :global([data-theme="dark"]) .moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }
</style>
