---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Radar from "./Radar.astro";
import { profile } from "@/data/profile";
import { loadCapture, scene } from "@/lib/flights";
import { htmlLang, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tr } = useT(lang);

// Cada CV solo aparece si su PDF existe en public/.
const inPublic = (file: string) => existsSync(join(process.cwd(), "public", file));
const cv = inPublic(profile.cv.standard) ? profile.cv.standard : null;
const europass = inPublic(tr(profile.cv.europass)) ? tr(profile.cv.europass) : null;

const loaded = loadCapture();
const sky = scene(loaded?.capture, profile.radarCenter);
const flights = sky.tracks.length;

const caption = (() => {
  if (!loaded) return null;
  if (loaded.sample) return t("radarSample");
  const opts = { timeZone: profile.timeZone, hourCycle: "h23" } as const;
  const hm = new Intl.DateTimeFormat(htmlLang[lang], { ...opts, hour: "2-digit", minute: "2-digit" });
  const from = new Date(loaded.capture.from);
  return t("radarCaption", {
    day: new Intl.DateTimeFormat(htmlLang[lang], { ...opts, day: "numeric", month: "short" }).format(from),
    from: hm.format(from),
    to: hm.format(new Date(loaded.capture.to)),
  });
})();
---

<section class="hero on-scope" aria-labelledby="hero-title">
  <Radar scene={sky} lang={lang} class="sky" label={flights ? t("radarAlt", { n: flights }) : undefined} />
  <div class="scrim" aria-hidden="true"></div>
  <div class="grain layer" aria-hidden="true"></div>

  <div class="wrap inner">
    <div class="copy">
      <p class="who data rise" style="--i:0">{profile.name} · {tr(profile.role)}</p>
      <h1 id="hero-title" class="hello rise" style="--i:1">{t("hello")}</h1>
      <div class="intro rise" style="--i:2">
        {profile.intro.map((p) => <p>{tr(p)}</p>)}
      </div>

      <div class="actions rise" style="--i:3">
        <a class="btn btn--fill" href={`mailto:${profile.email}`}>{t("writeMe")}</a>
        {
          cv && (
            <a class="btn btn--line" href={cv} target="_blank" rel="noopener">
              {t("downloadCv")}
            </a>
          )
        }
      </div>

      <p class="more rise" style="--i:4">
        <a class="link" href={profile.links.github} target="_blank" rel="me noopener">
          GitHub<span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link" href={profile.links.linkedin} target="_blank" rel="me noopener">
          LinkedIn<span class="arrow" aria-hidden="true">↗</span>
        </a>
        {
          europass && (
            <a class="link" href={europass} target="_blank" rel="noopener">
              {t("cvEuropass")}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }
      </p>
    </div>
  </div>

  {
    caption && (
      <div class="wrap readout data rise" style="--i:5">
        <p>{caption}</p>
        {flights > 0 && (
          <p class="live">
            <span data-radar-clock>--:--</span> · <span data-radar-count>0</span> {t("radarInAir")}
          </p>
        )}
      </div>
    )
  }
</section>

<style>
  /* Toda la primera pantalla es el cielo; el texto va encima. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 21rem 2rem;
    background: var(--scope);
  }

  /* En móvil la escena va arriba, lo primero que se ve. */
  .hero :global(.sky) {
    --cx: 0.5;
    --cy: 0.62;
    --rw: 0.6;
    --rh: 1;
    position: absolute;
    inset: 3.5rem 0 auto;
    z-index: -2;
    height: 18.5rem;
    -webkit-mask-image: linear-gradient(#000 80%, transparent);
    mask-image: linear-gradient(#000 80%, transparent);
  }

  .scrim {
    display: none;
  }

  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  @media (min-width: 60rem) {
    .hero {
      display: grid;
      align-items: center;
      min-height: max(42rem, 100svh);
      padding-block: 6rem 5rem;
    }

    /* En escritorio llena la pantalla y se sale por la derecha. */
    .hero :global(.sky) {
      --cx: 0.7;
      --cy: 0.57;
      --rw: 0.44;
      --rh: 0.98;
      inset: 0;
      height: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    /* Deja limpio el lado del texto. */
    .scrim {
      display: block;
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(90deg, var(--scope) 30%, transparent 60%);
    }
  }

  .copy {
    max-width: 33rem;
  }

  .who {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .hello {
    margin-top: 1.1rem;
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  /* Lectura del radar: qué se está viendo y el reloj de la reproducción. */
  .readout {
    display: grid;
    gap: 0.15rem;
    margin-top: 2.5rem;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .live {
    color: var(--ink);
  }

  @media (min-width: 60rem) {
    .readout {
      position: absolute;
      inset: auto 0 1.5rem;
      justify-items: end;
      margin-top: 0;
      text-align: right;
    }
  }

  @media (max-width: 30rem) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
