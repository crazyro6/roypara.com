---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Radar from "./Radar.astro";
import { profile } from "@/data/profile";
import { loadCapture, plot } from "@/lib/flights";
import { htmlLang, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tr } = useT(lang);

// Cada CV solo aparece si su PDF existe en public/.
const inPublic = (file: string) => existsSync(join(process.cwd(), "public", file));
const cv = inPublic(profile.cv.standard) ? profile.cv.standard : null;
const europass = inPublic(tr(profile.cv.europass)) ? tr(profile.cv.europass) : null;

const loaded = loadCapture();
const radar = plot(loaded?.capture, profile.radarCenter);

const caption = (() => {
  if (!loaded) return null;
  if (loaded.sample) return t("radarSample");
  const opts = { timeZone: profile.timeZone, hourCycle: "h23" } as const;
  const hm = new Intl.DateTimeFormat(htmlLang[lang], { ...opts, hour: "2-digit", minute: "2-digit" });
  const from = new Date(loaded.capture.from);
  return t("radarCaption", {
    n: radar.tracks.length,
    day: new Intl.DateTimeFormat(htmlLang[lang], { ...opts, day: "numeric", month: "short" }).format(from),
    from: hm.format(from),
    to: hm.format(new Date(loaded.capture.to)),
  });
})();
---

<section class="hero on-scope" aria-labelledby="hero-title">
  <div class="grain layer" aria-hidden="true"></div>

  <div class="wrap inner">
    <div class="copy">
      <p class="who data rise" style="--i:0">{profile.name} · {tr(profile.role)}</p>
      <h1 id="hero-title" class="hello rise" style="--i:1">{t("hello")}</h1>
      <div class="intro rise" style="--i:2">
        {profile.intro.map((p) => <p>{tr(p)}</p>)}
      </div>

      <div class="actions rise" style="--i:3">
        <a class="btn btn--fill" href={`mailto:${profile.email}`}>{t("writeMe")}</a>
        {
          cv && (
            <a class="btn btn--line" href={cv} target="_blank" rel="noopener">
              {t("downloadCv")}
            </a>
          )
        }
      </div>

      <p class="more rise" style="--i:4">
        <a class="link" href={profile.links.github} target="_blank" rel="me noopener">
          GitHub<span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link" href={profile.links.linkedin} target="_blank" rel="me noopener">
          LinkedIn<span class="arrow" aria-hidden="true">↗</span>
        </a>
        {
          europass && (
            <a class="link" href={europass} target="_blank" rel="noopener">
              {t("cvEuropass")}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )
        }
      </p>
    </div>

    <figure class="scope">
      <Radar radar={radar} title={radar.tracks.length ? t("radarAlt", { n: radar.tracks.length }) : undefined} />
      <figcaption class="readout data">
        {caption && <p>{caption}</p>}
        <p>
          {radar.tracks.length > 0 && <>{t("radarCount", { n: radar.tracks.length })} · </>}
          {t("radarRange", { n: radar.r })} ·{" "}
          <time data-clock data-tz={profile.timeZone} data-locale={htmlLang[lang]}>--:--</time>{" "}
          {t("localTime")}
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLTimeElement>("[data-clock]");
  const tick = () =>
    els.forEach((el) => {
      el.textContent = new Intl.DateTimeFormat(el.dataset.locale, {
        timeZone: el.dataset.tz,
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      }).format(new Date());
    });
  tick();
  setInterval(tick, 15_000);
</script>

<style>
  /* A sangre, del borde de arriba (bajo la cabecera) al final de la pantalla. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 6.5rem 3.5rem;
    background:
      radial-gradient(60rem 44rem at 72% 48%, color-mix(in oklch, var(--scope-glow) 70%, transparent), transparent 70%),
      radial-gradient(120% 90% at 50% 0%, transparent 55%, oklch(0 0 0 / 0.35)),
      var(--scope);
  }

  .layer {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .inner {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .hero {
      display: grid;
      align-items: center;
      min-height: max(40rem, 100svh);
      padding-block: 6rem 3rem;
    }

    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 4rem;
    }
  }

  .who {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .hello {
    margin-top: 1.1rem;
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    display: grid;
    gap: 0.9rem;
    max-width: 32rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .scope {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .scope :global(.radar) {
    width: min(100%, 40rem, 76svh);
  }

  .readout {
    display: grid;
    gap: 0.2rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    text-align: center;
  }

  .readout time {
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
