---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import photo from "@/assets/roy.png";
import { profile } from "@/data/profile";
import { htmlLang, useT, type Lang } from "@/i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tr } = useT(lang);

// Cada CV solo aparece si su PDF existe en public/.
const inPublic = (file: string) => existsSync(join(process.cwd(), "public", file));
const cvs = [
  // Con un solo PDF el botón es entero y lleva la nota corta ("PDF").
  { href: profile.cv.standard, label: t("downloadCv"), note: t("cvStandardNote"), solo: t("cvLangNote") },
  { href: tr(profile.cv.europass), label: "Europass", note: t("cvEuropassNote"), sr: "CV " },
].filter((cv) => inPublic(cv.href));
if (cvs.length === 1 && cvs[0].solo) cvs[0].note = cvs[0].solo;

const links = [
  { label: "GitHub", href: profile.links.github },
  { label: "LinkedIn", href: profile.links.linkedin },
];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="head">
    {
      profile.status && (
        <p class="status rise" style="--i:0">
          <span class="dot" aria-hidden="true" />
          {tr(profile.status)}
        </p>
      )
    }
    <div class="id">
      <h1 id="hero-name" class="name rise" style="--i:1">{profile.name}</h1>
      <p class="role rise" style="--i:2">{tr(profile.role)}</p>
    </div>
    <Image
      class="photo rise"
      style="--i:1"
      src={photo}
      alt={t("photoAlt")}
      width={144}
      height={144}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="bio rise" style="--i:3">
    {profile.bio.map((p) => <p>{tr(p)}</p>)}
  </div>

  <p class="meta mono rise" style="--i:4">
    <span>{profile.location}</span>
    <span class="coords" aria-hidden="true">{profile.coordinates}</span>
    <span class="clock">
      <time data-clock data-tz={profile.timeZone} data-locale={htmlLang[lang]}>--:--</time>
      {t("localTime")}
    </span>
  </p>

  <ul class="links rise" style="--i:5" role="list">
    {
      links.map((l) => (
        <li>
          <a class="link" href={l.href} target="_blank" rel="me noopener">
            {l.label}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))
    }
    <li>
      <a class="link" href={`mailto:${profile.email}`}>Email</a>
    </li>
    {
      cvs.length > 0 && (
        <li>
          <div class="cv" role="group" aria-label={t("cvGroup")}>
            {cvs.map((cv) => (
              <a href={cv.href} target="_blank" rel="noopener">
                {cv.sr && <span class="sr-only">{cv.sr}</span>}
                {cv.label}
                {cv.note && <span class="note mono">{cv.note}</span>}
              </a>
            ))}
          </div>
        </li>
      )
    }
  </ul>
</section>

<script>
  const els = document.querySelectorAll<HTMLTimeElement>("[data-clock]");
  const tick = () =>
    els.forEach((el) => {
      const fmt = new Intl.DateTimeFormat(el.dataset.locale, {
        timeZone: el.dataset.tz,
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      });
      el.textContent = fmt.format(new Date());
    });
  tick();
  setInterval(tick, 15_000);
</script>

<style>
  .hero {
    padding-top: clamp(1rem, 0.5rem + 2.5vw, 2.5rem);
  }

  /* Nombre a la izquierda, foto a la derecha. */
  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "status photo"
      "id photo";
    column-gap: 1.25rem;
  }

  .head .status {
    grid-area: status;
    align-self: end;
    justify-self: start;
  }

  .id {
    grid-area: id;
    align-self: start;
  }

  .photo {
    grid-area: photo;
    align-self: center;
  }

  /* En móvil el estado ocupa toda la fila y la foto va junto al nombre. */
  @media (max-width: 30rem) {
    .head {
      grid-template-areas:
        "status status"
        "id photo";
    }

    .id {
      align-self: center;
    }
  }

  .photo {
    width: clamp(5.5rem, 4rem + 6vw, 8.75rem);
    height: auto;
    aspect-ratio: 1;
    margin: 6px;
    border-radius: 999px;
    object-fit: cover;
    background: var(--card);
    box-shadow:
      0 0 0 1px var(--card-line),
      0 0 0 6px color-mix(in oklch, var(--card) 70%, transparent),
      0 18px 40px -22px oklch(0.3 0.06 240 / 0.45);
  }

  .status {
    display: inline-flex;
    margin-bottom: 1.1rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--live);
    flex: none;
  }

  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--live);
    animation: ping 2.6s var(--ease-out) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .name {
    font-size: var(--step-3);
    letter-spacing: -0.025em;
  }

  .role {
    margin-top: 0.35rem;
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .bio {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
    max-width: 62ch;
    color: var(--ink-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.1rem;
    margin-top: 1.75rem;
    color: var(--ink-3);
    font-size: var(--step--1);
  }

  .clock time {
    color: var(--ink);
    display: inline-block;
    min-width: 5ch;
    margin-right: 0.5ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  /* Botón de CV: una píldora que se divide en dos si hay Europass. */
  .cv {
    display: inline-flex;
    border-radius: 999px;
    background: var(--ink);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out);
  }

  .cv:hover {
    transform: translateY(-1px);
  }

  .cv a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    color: var(--bg);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s var(--ease-out);
  }

  .cv a + a {
    border-left: 1px solid color-mix(in oklch, var(--bg) 25%, transparent);
  }

  .cv a:hover {
    background: var(--accent);
  }

  .cv a:focus-visible {
    outline: 2px solid var(--bg);
    outline-offset: -4px;
    border-radius: 999px;
  }

  .note {
    opacity: 0.65;
    font-weight: 400;
  }

  @media (max-width: 30rem) {
    .coords {
      display: none;
    }
  }
</style>
